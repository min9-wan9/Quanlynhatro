# Kết nối PostgreSQL (Cục bộ hoặc Cloud như Neon / Supabase)
DATABASE_URL="postgresql://postgres:secretpassword@localhost:5432/nhatro_db?schema=public"

# Cổng chạy Backend
PORT=3000

# Khóa API Google Gemini (Dành cho Trợ lý Chatbot AI)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# VNPay Sandbox (Tùy chọn - nếu bỏ trống hệ thống tự dùng VNPay Sandbox Simulator nội bộ để test)
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
FRONTEND_URL="http://localhost:5173"


